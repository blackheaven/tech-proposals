              "oneOf": [
                { "$ref": "#/$defs/doc" },
                { "type": "null" }
              ]
            }
          },
          "required": ["tag", "name"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "tag": { "const": "DocWarning" },
            "document": { "$ref": "#/$defs/doc" }
          },
          "required": ["tag", "document"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "tag": { "const": "DocEmphasis" },
