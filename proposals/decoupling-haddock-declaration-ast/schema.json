    "tableRow": {
      "type": "array",
      "items": { "$ref": "#/$defs/tableCell" }
    },

    "tableCell": {
      "type": "object",
      "properties": {
        "colspan": { "type": "integer" },
        "rowspan": { "type": "integer" },
        "contents": { "$ref": "#/$defs/doc" }
      },
      "required": ["colspan", "rowspan", "contents"],
      "additionalProperties": false
    }
  }
}
