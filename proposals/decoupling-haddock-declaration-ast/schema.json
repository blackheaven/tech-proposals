          },
          "required": ["tag", "document"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "tag": { "const": "DocBold" },
            "document": { "$ref": "#/$defs/doc" }
          },
          "required": ["tag", "document"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "tag": { "const": "DocMonospaced" },
