                "type": "object",
                "properties": {
                  "expression": { "type": "string" },
                  "result": {
                    "type": "array",
                    "items": { "type": "string" }
                  }
                },
                "required": ["expression", "result"],
                "additionalProperties": false
              }
            }
          },
          "required": ["tag", "examples"],
