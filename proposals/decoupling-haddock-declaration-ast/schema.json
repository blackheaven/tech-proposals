    "hsForAllTelescope": {
      "oneOf": [
        {
          "type": "object",
          "description": "Visible forall (type-level, @->@)",
          "properties": {
            "tag": { "const": "HsForAllVis" },
            "binders": {
              "type": "array",
              "items": { "$ref": "#/$defs/tyVarBndr" }
            }
          },
          "required": ["tag", "binders"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "Invisible forall (term-level, @.@)",
          "properties": {
            "tag": { "const": "HsForAllInvis" },
            "binders": {
              "type": "array",
              "items": { "$ref": "#/$defs/tyVarBndr" }
            }
          },
          "required": ["tag", "binders"],
          "additionalProperties": false
        }
      ]
    },

    "tyVarBndr": {
      "type": "object",
      "description": "A type variable binder",
      "properties": {
        "name": { "$ref": "#/$defs/nameRef" },
        "visibility": {
          "type": "string",
          "enum": ["Required", "Inferred", "Specified"]
        },
        "kind": {
          "oneOf": [
            { "$ref": "#/$defs/hsType" },
            { "type": "null" }
          ]
        }
      },
      "required": ["name", "visibility"],
      "additionalProperties": false
    },

    "hsTyLit": {
      "oneOf": [
        {
          "type": "object",
