          },
          "required": ["tag", "level", "title"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "tag": { "const": "DocTable" },
            "headerRows": {
              "type": "array",
              "items": { "$ref": "#/$defs/tableRow" }
            },
            "bodyRows": {
              "type": "array",
              "items": { "$ref": "#/$defs/tableRow" }
            }
          },
          "required": ["tag", "headerRows", "bodyRows"],
          "additionalProperties": false
        }
      ]
